Subject: [PATCH] 
 TT-11-kimi_k3-keep-the-model-importable-without-attn_gym-CuTe-short-conv

---
 torchtitan/models/kimi_k3/kda.py | 32 +++++++++++++++++++++++++++++++-
 1 file changed, 31 insertions(+), 1 deletion(-)

diff --git a/torchtitan/models/kimi_k3/kda.py b/torchtitan/models/kimi_k3/kda.py
index ac53adc10..02ebf9e37 100644
--- a/torchtitan/models/kimi_k3/kda.py
+++ b/torchtitan/models/kimi_k3/kda.py
@@ -12,7 +12,37 @@ import torch
 import torch.nn.functional as F
 from attn_gym.linear.kda import bound_gate, chunk_kda
 from attn_gym.linear.kda.fwd.triton.l2norm_fwd import l2norm
-from attn_gym.linear.kda.short_conv import causal_conv1d
+try:
+    from attn_gym.linear.kda.short_conv import causal_conv1d
+except ImportError:  # pragma: no cover - attn_gym's CuTe backend needs the CUDA-only `cutlass` package
+    # attn_gym imports its CuTe short-conv kernels eagerly, so on non-CUDA installs the
+    # whole model package became un-importable. Fall back to a plain-torch depthwise
+    # causal conv (per packed document when cu_seqlens is given); the fused KDA path
+    # already has attn_gym's own naive fallback.
+    import torch.nn.functional as F
+
+    def causal_conv1d(x, weight, *, activation=None, cu_seqlens=None, **_unused):
+        """x: (B, T, C); weight: (C, W). Returns (B, T, C)."""
+        channels, width = weight.shape
+        w = weight.to(x.dtype).unsqueeze(1)  # (C, 1, W)
+
+        def _conv(seq_btc):
+            seq = F.pad(seq_btc.transpose(1, 2), (width - 1, 0))  # (B, C, T + W - 1)
+            return F.conv1d(seq, w, groups=channels).transpose(1, 2)
+
+        if cu_seqlens is None:
+            out = _conv(x)
+        else:
+            assert x.shape[0] == 1, "packed sequences use batch size 1"
+            bounds = cu_seqlens.tolist()
+            out = torch.cat(
+                [_conv(x[:, s:e]) for s, e in zip(bounds[:-1], bounds[1:])], dim=1
+            )
+        if activation == "silu":
+            out = F.silu(out)
+        elif activation is not None:
+            raise NotImplementedError(f"causal_conv1d fallback: activation {activation!r}")
+        return out
 from torch import nn
 
 from torchtitan.models.common.attention import AttentionMasksType, VarlenMetadata
