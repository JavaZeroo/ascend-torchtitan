From bb69308297aeb8dc9f1fd0b4b3cb76875a3b00da Mon Sep 17 00:00:00 2001
From: ascend-torchtitan <maintainers@ascend-torchtitan>
Date: Sat, 29 Aug 2026 23:30:12 +0800
Subject: [PATCH 3/3] TT-8: pipeline step: fall back to _step_microbatches when
 step() lacks the arg_mbs contract

---
 torchtitan/trainer.py | 43 +++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 41 insertions(+), 2 deletions(-)

diff --git a/torchtitan/trainer.py b/torchtitan/trainer.py
index b6814b5d7..6a173fe22 100644
--- a/torchtitan/trainer.py
+++ b/torchtitan/trainer.py
@@ -756,13 +756,12 @@ class Trainer(torch.distributed.checkpoint.stateful.Stateful, Configurable):
         loss_kwargs = {"global_valid_tokens": global_valid_tokens}
         with self.train_context():
             losses = [] if self.pp_has_last_stage else None
-            self.pp_schedule.step(
+            self._pp_step_presplit(
                 arg_mbs=arg_mbs if self.pp_has_first_stage else None,
                 kwarg_mbs=kwarg_mbs,
                 target_mbs=target_mbs,
                 losses=losses,
                 loss_kwargs=loss_kwargs,
-                return_outputs=False,
             )
 
         # TODO: PP+FSDP unexpectedly puts the loss back to the CPU.
@@ -771,6 +770,46 @@ class Trainer(torch.distributed.checkpoint.stateful.Stateful, Configurable):
             return torch.sum(torch.stack(losses)).to(self.device)
         return torch.tensor([-1.0], device=self.device)
 
+    def _pp_step_presplit(self, *, arg_mbs, kwarg_mbs, target_mbs, losses, loss_kwargs):
+        """Run one pipeline iteration on pre-split microbatches.
+
+        ``PipelineSchedule.step(arg_mbs=...)`` is a nightly-only contract; released
+        torch (<= 2.13) exposes the same functionality as ``_step_microbatches``.
+        """
+        import functools
+        import inspect
+
+        schedule = self.pp_schedule
+        if "arg_mbs" in inspect.signature(schedule.step).parameters:
+            schedule.step(
+                arg_mbs=arg_mbs,
+                kwarg_mbs=kwarg_mbs,
+                target_mbs=target_mbs,
+                losses=losses,
+                loss_kwargs=loss_kwargs,
+                return_outputs=False,
+            )
+            return
+        # Preamble mirrored from torch 2.12/2.13 step(): grad check, stage flags, reset.
+        if schedule._has_backward and not torch.is_grad_enabled():
+            raise RuntimeError(
+                "step() requires gradients to be enabled for backward computation"
+            )
+        stages = getattr(schedule, "_stages", None) or [schedule._stage]
+        for stage in stages:
+            stage.has_backward = schedule._has_backward
+            stage.clear_runtime_states()
+        step_mbs = schedule._step_microbatches
+        if "loss_kwargs" in inspect.signature(step_mbs).parameters:
+            step_mbs(arg_mbs, kwarg_mbs, target_mbs, losses, False, loss_kwargs=loss_kwargs)
+        else:  # torch 2.12: no loss_kwargs plumbing; bind them for this step only
+            saved = schedule._loss_fn
+            schedule._loss_fn = functools.partial(saved, **loss_kwargs)
+            try:
+                step_mbs(arg_mbs, kwarg_mbs, target_mbs, losses, False)
+            finally:
+                schedule._loss_fn = saved
+
     def train_step(
         self, data_iterator: Iterator[tuple[dict[str, torch.Tensor], torch.Tensor]]
     ):
-- 
