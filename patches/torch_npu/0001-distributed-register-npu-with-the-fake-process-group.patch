From 95e195b270bde1a905dbe337e50a6dfb2e8b7cc3 Mon Sep 17 00:00:00 2001
From: ascend-torchtitan <jimmy.eyjc@gmail.com>
Date: Sat, 29 Aug 2026 23:40:17 +0800
Subject: [PATCH] distributed: register npu with the fake process-group backend

torch.distributed's in-tree fake backend lists cpu/cuda/hpu/xpu as its
devices; out-of-tree backends have to append themselves. Without this, any
fake-process-group run with npu tensors (torchtitan --comm.mode=fake_backend,
config dry runs, pipeline dry runs) fails at the first collective with
'RuntimeError: No backend type associated with device type npu'.

Validated on Ascend 910B2 / CANN 9.1.0 with torch 2.13.0 + torch_npu
2.13.0rc1: torchtitan qwen3 debugmodel dry run with NGPU=8 fake process
groups completes (previously failed in set_determinism's broadcast).
---
 torch_npu/_init/registry/distributed.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/torch_npu/_init/registry/distributed.py b/torch_npu/_init/registry/distributed.py
index 82ff3ad7e..5da9fac0e 100644
--- a/torch_npu/_init/registry/distributed.py
+++ b/torch_npu/_init/registry/distributed.py
@@ -43,6 +43,13 @@ def register_distributed_backend_for_npu():
         devices=["npu"],
     )
 
+    # Let the in-tree fake process-group backend accept npu tensors so dry runs
+    # (e.g. torchtitan --comm.mode=fake_backend) work without HCCL. HPU/XPU are
+    # listed in-tree; out-of-tree backends have to append themselves.
+    fake_devices = torch.distributed.Backend.backend_capability.get("fake")
+    if fake_devices is not None and "npu" not in fake_devices:
+        fake_devices.append("npu")
+
     # init and register lccl backend
     torch.distributed.Backend.register_backend(
         "lccl",
-- 
