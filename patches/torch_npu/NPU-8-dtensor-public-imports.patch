+class AutoloadImportFootprintTest(TestCase):
+    """torch_npu is imported from inside `import torch` (device-backend autoload). Anything it
+    imports eagerly is therefore imported by every `import torch`; in particular it must not pull
+    torch.distributed.checkpoint / fsdp, which themselves import third-party packages (spmd_types)
+    at module level -- a package that does `import torch` at its own top level then dies with
+    "partially initialized module 'spmd_types' ... (most likely due to a circular import)".
+    torch.distributed._tensor (the deprecated alias) drags that chain in; the public
+    torch.distributed.tensor modules do not."""
+
+    @unittest.skipIf(not AUTO_LOAD, "requires device backend autoload")
+    def test_import_torch_does_not_load_checkpoint_or_fsdp(self):
+        code = (
+            "import sys, torch\n"
+            "assert 'torch_npu' in sys.modules, 'torch_npu was not autoloaded'\n"
+            "bad = [m for m in ('torch.distributed.checkpoint', 'torch.distributed.fsdp') if m in sys.modules]\n"
+            "assert not bad, f'import torch loaded {bad} through torch_npu'\n"
+            "import torch.distributed.fsdp.sharded_grad_scaler as s\n"
+            "assert s.ShardedGradScaler.__module__.startswith('torch_npu'), s.ShardedGradScaler\n"
+        )
+        subprocess.run([sys.executable, "-c", code], check=True)
+
+
