new file mode 100644
index 000000000..669d94908
--- /dev/null
+++ b/torch_npu/utils/_import_hooks.py
@@ -0,0 +1,77 @@
+"""Run a callback right after a module finishes importing, without importing it eagerly.
+
+torch_npu is imported from inside ``import torch`` (device-backend autoload), so anything it
+imports at init time is imported by every ``import torch``. Patches that target modules such as
+``torch.distributed.fsdp.sharded_grad_scaler`` must therefore wait for the *user* to import
+those modules instead of pulling them in themselves.
+"""
+
+import importlib.abc
+import importlib.machinery
+import sys
+from typing import Callable, Dict, List
+
+
+class _PostImportLoader(importlib.abc.Loader):
+    """Loader wrapper that runs callbacks after the wrapped loader executed the module."""
+
+    def __init__(self, loader, callbacks: List[Callable]):
+        self._loader = loader
+        self._callbacks = callbacks
+
+    def create_module(self, spec):
+        create = getattr(self._loader, "create_module", None)
+        return create(spec) if create is not None else None
+
+    def exec_module(self, module):
+        self._loader.exec_module(module)
+        for callback in self._callbacks:
+            callback(module)
+
+    def __getattr__(self, name):  # delegate get_code / is_package / ... to the real loader
+        return getattr(self._loader, name)
+
+
+class _PostImportFinder(importlib.abc.MetaPathFinder):
+    """Meta-path finder that decorates the real spec of registered modules."""
+
+    def __init__(self):
+        self._hooks: Dict[str, List[Callable]] = {}
+
+    def register(self, module_name: str, callback: Callable):
+        self._hooks.setdefault(module_name, []).append(callback)
+
+    def find_spec(self, fullname, path, target=None):
+        callbacks = self._hooks.get(fullname)
+        if not callbacks:
+            return None
+        for finder in sys.meta_path:
+            if finder is self:
+                continue
+            find = getattr(finder, "find_spec", None)
+            if find is None:
+                continue
+            spec = find(fullname, path, target)
+            if spec is not None and spec.loader is not None:
+                del self._hooks[fullname]
+                spec.loader = _PostImportLoader(spec.loader, callbacks)
+                return spec
+        return None
+
+
+_finder = _PostImportFinder()
+
+
+def run_after_import(module_name: str, callback: Callable) -> None:
+    """Call ``callback(module)`` once ``module_name`` has been imported.
+
+    If the module is already imported the callback runs immediately; otherwise it runs right
+    after the module body executes, from whichever import statement pulls it in first.
+    """
+    module = sys.modules.get(module_name)
+    if module is not None:
+        callback(module)
+        return
+    if _finder not in sys.meta_path:
+        sys.meta_path.insert(0, _finder)
+    _finder.register(module_name, callback)
