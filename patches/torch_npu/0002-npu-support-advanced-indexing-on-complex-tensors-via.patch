From cf0225619abdb147106f41698b51abd15157b44b Mon Sep 17 00:00:00 2001
From: ascend-torchtitan <jimmy.eyjc@gmail.com>
Date: Sat, 29 Aug 2026 23:42:54 +0800
Subject: [PATCH] npu: support advanced indexing on complex tensors via the
 real view

aclnnIndex (op-plugin index.Tensor) rejects complex inputs
(AclNN_Parameter_Error EZ1001: Tensor self not implemented for DT_COMPLEX64),
so complex_tensor[index_tensor] fails on NPU. This breaks, for example,
torchtitan's ComplexRoPE (freqs_cis[positions]) for llama3 / deepseek_v3 /
gpt_oss / kimi models at the first forward.

Route Tensor.__getitem__ on complex NPU tensors through view_as_real: all
index forms apply to the leading dims unchanged, and an appended slice(None)
keeps the (real, imag) pair dim so view_as_complex is valid on the result.
Basic int/slice indexing does not use aclnnIndex and is left untouched.

Validated on Ascend 910B2 / CANN 9.1.0, torch 2.13.0 + torch_npu 2.13.0rc1:
- index tensor, mixed (tensor, slice), Ellipsis, None and boolean-mask forms
  match the CPU result;
- torchtitan llama3 debugmodel with the stock ComplexRoPE trains 10 steps
  (FSDP2 x4), previously failing with error code 161002.

The proper long-term fix is complex support in the aclnnIndex kernel; this
Python-level routing removes the user-visible failure until then.
---
 torch_npu/_init/patches/npu_patches.py |  7 ++++++
 torch_npu/utils/patch_complex_index.py | 33 ++++++++++++++++++++++++++
 2 files changed, 40 insertions(+)
 create mode 100644 torch_npu/utils/patch_complex_index.py

diff --git a/torch_npu/_init/patches/npu_patches.py b/torch_npu/_init/patches/npu_patches.py
index 578781424..0d227ce04 100644
--- a/torch_npu/_init/patches/npu_patches.py
+++ b/torch_npu/_init/patches/npu_patches.py
@@ -42,3 +42,10 @@ def apply_npu_internal_format_repr_patch():
         return _orig_repr(self, tensor_contents=tensor_contents)
 
     torch.Tensor.__repr__ = _npu_internal_format_repr
+
+
+@PatchManager.register_patch("npu")
+def apply_complex_index_patch():
+    from torch_npu.utils.patch_complex_index import _apply_complex_index_patch
+
+    _apply_complex_index_patch()
diff --git a/torch_npu/utils/patch_complex_index.py b/torch_npu/utils/patch_complex_index.py
new file mode 100644
index 000000000..8f553cdec
--- /dev/null
+++ b/torch_npu/utils/patch_complex_index.py
@@ -0,0 +1,33 @@
+"""Advanced indexing on complex NPU tensors.
+
+``aclnnIndex`` (op-plugin ``index.Tensor``) rejects complex inputs
+(``AclNN_Parameter_Error EZ1001: Tensor self not implemented for DT_COMPLEX64``),
+so ``complex_tensor[index_tensor]`` fails on NPU while the same call works for
+real dtypes. Until the kernel supports complex natively, route ``__getitem__``
+on complex NPU tensors through the ``(..., 2)`` real view: every index form
+(ints, slices, Ellipsis, None, index tensors, boolean masks over the complex
+shape) applies unchanged to the leading dims, and the appended ``slice(None)``
+keeps the real/imag pair dim intact so ``view_as_complex`` is valid again.
+
+Basic single-int / single-slice indexing does not go through aclnnIndex and is
+left untouched.
+"""
+
+import torch
+
+_orig_getitem = torch.Tensor.__getitem__
+
+
+def _complex_npu_getitem(self, index):
+    if self.is_complex() and self.device.type == "npu" and not isinstance(index, (int, slice)):
+        items = index if isinstance(index, tuple) else (index,)
+        out = _orig_getitem(torch.view_as_real(self), (*items, slice(None)))
+        return torch.view_as_complex(out)
+    return _orig_getitem(self, index)
+
+
+def _apply_complex_index_patch():
+    if getattr(torch.Tensor, "_npu_complex_index_patched", False):
+        return
+    torch.Tensor.__getitem__ = _complex_npu_getitem
+    torch.Tensor._npu_complex_index_patched = True
