new file mode 100644
index 000000000..75d580509
--- /dev/null
+++ b/test/npu/test_flash_attention_privateuse1.py
@@ -0,0 +1,98 @@
+import unittest
+
+import torch
+import torch_npu
+from torch_npu.testing.testcase import TestCase, run_tests
+
+try:
+    from torch.nn.attention.varlen import varlen_attn
+except ImportError:  # torch < 2.10
+    varlen_attn = None
+
+
+def _uint64_zero_supported():
+    try:
+        torch.zeros((2,), dtype=torch.uint64, device="npu")
+        return True
+    except RuntimeError:
+        return False
+
+
+def _ref_causal(q, k, v, scale):
+    """fp32 reference for one (S, N, D) document with right-aligned causal masking; GQA by
+    repeating kv heads. Differentiable (pass CPU leaves to get reference grads).
+    Returns (out (S, N, D), lse (N, S))."""
+    q, k, v = (t.float() for t in (q, k, v))
+    n_q, n_kv = q.shape[1], k.shape[1]
+    if n_q != n_kv:
+        k = k.repeat_interleave(n_q // n_kv, dim=1)
+        v = v.repeat_interleave(n_q // n_kv, dim=1)
+    s = torch.einsum("qnd,knd->nqk", q, k) * scale
+    mask = torch.ones(s.shape[-2], s.shape[-1], dtype=torch.bool).triu(1)
+    s = s.masked_fill(mask, float("-inf"))
+    lse = torch.logsumexp(s, dim=-1)
+    out = torch.einsum("nqk,knd->qnd", torch.softmax(s, dim=-1), v)
+    return out, lse
+
+
+class TestFlashAttentionPrivateUse1(TestCase):
+    """aten::_flash_attention_forward / _backward on NPU (npu_fusion_attention), the ops behind
+    torch.nn.attention.varlen.varlen_attn and the SDPA flash path."""
+
+    def test_kernels_registered(self):
+        has = torch._C._dispatch_has_kernel_for_dispatch_key
+        self.assertTrue(has("aten::_flash_attention_forward", "PrivateUse1"))
+        self.assertTrue(has("aten::_flash_attention_backward", "PrivateUse1"))
+
+    def test_dense_causal_forward(self):
+        torch.manual_seed(0)
+        b, s, n, d = 2, 128, 4, 64
+        q, k, v = (torch.randn(b, s, n, d, dtype=torch.bfloat16, device="npu") for _ in range(3))
+        scale = d ** -0.5
+        out, lse, *_ = torch.ops.aten._flash_attention_forward(
+            q, k, v, None, None, s, s, 0.0, True, False, scale=scale)
+        self.assertEqual(out.shape, (b, s, n, d))
+        self.assertEqual(lse.shape, (b, n, s))
+        for i in range(b):
+            ref_out, ref_lse = _ref_causal(q[i].cpu(), k[i].cpu(), v[i].cpu(), scale)
+            self.assertRtolEqual(out[i].float().cpu().numpy(), ref_out.numpy(), prec=2e-2)
+            self.assertRtolEqual(lse[i].float().cpu().numpy(), ref_lse.numpy(), prec=2e-2)
+
+    @unittest.skipIf(varlen_attn is None, "torch.nn.attention.varlen not available")
+    @unittest.skipIf(not _uint64_zero_supported(), "varlen_attn needs uint64 zero_ on npu")
+    def test_varlen_causal_forward_backward(self):
+        for n_kv in (4, 1):  # MHA and GQA
+            torch.manual_seed(0)
+            lengths = [100, 156]
+            t, n, d = sum(lengths), 4, 64
+            q = torch.randn(t, n, d, dtype=torch.bfloat16, device="npu", requires_grad=True)
+            k = torch.randn(t, n_kv, d, dtype=torch.bfloat16, device="npu", requires_grad=True)
+            v = torch.randn(t, n_kv, d, dtype=torch.bfloat16, device="npu", requires_grad=True)
+            cu = torch.tensor([0, lengths[0], t], dtype=torch.int32, device="npu")
+            out = varlen_attn(q, k, v, cu, cu, max(lengths), max(lengths),
+                              window_size=(-1, 0), enable_gqa=(n_kv != n))
+            grad_out = torch.randn_like(out)
+            out.backward(grad_out)
+
+            qr, kr, vr = (x.detach().float().cpu().requires_grad_(True) for x in (q, k, v))
+            ref_outs = []
+            start = 0
+            for length in lengths:
+                sl = slice(start, start + length)
+                ref_outs.append(_ref_causal(qr[sl], kr[sl], vr[sl], d ** -0.5)[0])
+                start += length
+            ref_out = torch.cat(ref_outs)
+            ref_out.backward(grad_out.float().cpu())
+            self.assertRtolEqual(out.detach().float().cpu().numpy(), ref_out.detach().numpy(), prec=2e-2)
+            for got, ref in ((q.grad, qr.grad), (k.grad, kr.grad), (v.grad, vr.grad)):
+                self.assertRtolEqual(got.float().cpu().numpy(), ref.numpy(), prec=5e-2)
+
+    def test_unsupported_features_raise(self):
+        s, n, d = 32, 2, 64
+        q, k, v = (torch.randn(1, s, n, d, dtype=torch.bfloat16, device="npu") for _ in range(3))
+        with self.assertRaises(NotImplementedError):
+            torch.ops.aten._flash_attention_forward(q, k, v, None, None, s, s, 0.1, True, False)
+
+
+if __name__ == "__main__":
+    run_tests()
