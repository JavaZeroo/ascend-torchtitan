new file mode 100644
index 000000000..781f1ee60
--- /dev/null
+++ b/torch_npu/utils/patch_flash_attention.py
@@ -0,0 +1,207 @@
+"""PrivateUse1 kernels for ``aten::_flash_attention_forward`` / ``_backward``.
+
+PyTorch's ``torch.nn.attention.varlen.varlen_attn`` (and the SDPA flash path)
+lowers to these two aten ops, which only have CUDA (and ROCm/XPU) kernels.
+Provide NPU implementations on top of ``npu_fusion_attention`` so callers that
+use the public flash-attention contract -- torchtitan's ``VarlenAttention``
+among them -- run unmodified on Ascend.
+
+Contract (see torch/_meta_registrations.py::meta__flash_attention_forward):
+* dense:  ``query/key/value`` are ``(B, S, N, D)``; ``logsumexp`` is ``(B, N, S)``
+* varlen: ``query/key/value`` are ``(T, N, D)`` packed with ``cum_seq_q/k``
+  ``(num_seqs + 1,)`` offsets; ``logsumexp`` is ``(N, T)``
+* ``is_causal`` uses the right-aligned causal convention; ``window_size_left``
+  ``>= 0`` limits the left context (``sparse_mode=4``)
+* dropout is not supported on this path (``varlen_attn`` hard-codes 0.0)
+
+``npu_fusion_attention`` returns softmax statistics instead of a log-sum-exp.
+For ``TND`` they are stored per sequence, head-major, with 8 replicated
+lanes; ``_lse_from_stats`` folds them into the aten layout and
+``_stats_from_lse`` expands ``lse`` back for the backward kernel (which needs
+``softmax_max``/``softmax_sum`` such that ``P = exp(S - max) / sum``; the pair
+``(lse, 1)`` satisfies that identity).
+"""
+
+import torch
+
+_INT_MAX = 2147483647
+_CAUSAL_MASK_SIZE = 2048
+_STAT_LANES = 8
+_causal_masks = {}
+
+
+def _causal_mask(device):
+    m = _causal_masks.get(device)
+    if m is None:
+        m = torch.triu(
+            torch.ones(_CAUSAL_MASK_SIZE, _CAUSAL_MASK_SIZE, dtype=torch.bool, device=device),
+            diagonal=1,
+        )
+        _causal_masks[device] = m
+    return m
+
+
+def _offsets(cu_seq):
+    return [int(x) for x in cu_seq[1:].tolist()]
+
+
+def _sparse_args(is_causal, window_size_left, window_size_right):
+    """Map the aten masking arguments onto npu_fusion_attention's sparse modes."""
+    left = -1 if window_size_left is None else int(window_size_left)
+    right = -1 if window_size_right is None else int(window_size_right)
+    if right not in (-1, 0):
+        raise NotImplementedError("npu flash attention: window_size_right must be -1 or 0")
+    if left >= 0:
+        return 4, left, 0 if (is_causal or right == 0) else _INT_MAX
+    if is_causal or right == 0:
+        return 3, _INT_MAX, 0
+    return 0, _INT_MAX, _INT_MAX
+
+
+def _lse_from_stats(smax, ssum, layout, n_heads, ends):
+    fm = smax.reshape(-1, _STAT_LANES)[:, 0]
+    fs = ssum.reshape(-1, _STAT_LANES)[:, 0]
+    if layout == "BSND":
+        b, s = smax.shape[0], smax.shape[2]
+        return (fm + torch.log(fs)).reshape(b, n_heads, s)
+    pieces, start = [], 0
+    for end in ends:
+        length = end - start
+        m = fm[start * n_heads : end * n_heads].reshape(n_heads, length)
+        z = fs[start * n_heads : end * n_heads].reshape(n_heads, length)
+        pieces.append(m + torch.log(z))
+        start = end
+    return torch.cat(pieces, dim=1)  # (N, T)
+
+
+def _stats_from_lse(lse, layout, shape, ends):
+    """Inverse of ``_lse_from_stats`` with ``softmax_sum == 1``."""
+    if layout == "BSND":
+        b, s, n, _ = shape
+        smax = lse.reshape(b, n, s, 1).expand(b, n, s, _STAT_LANES).contiguous()
+        return smax, torch.ones_like(smax)
+    t, n, _ = shape
+    pieces, start = [], 0
+    for end in ends:
+        pieces.append(lse[:, start:end].reshape(-1))  # head-major within the sequence
+        start = end
+    flat = torch.cat(pieces)
+    smax = flat.reshape(t * n, 1).expand(t * n, _STAT_LANES).reshape(t, n, _STAT_LANES).contiguous()
+    return smax, torch.ones_like(smax)
+
+
+def _flash_attention_forward_npu(
+    query,
+    key,
+    value,
+    cum_seq_q,
+    cum_seq_k,
+    max_q,
+    max_k,
+    dropout_p,
+    is_causal,
+    return_debug_mask,
+    *,
+    scale=None,
+    window_size_left=None,
+    window_size_right=None,
+    seqused_k=None,
+    alibi_slopes=None,
+    block_table=None,
+    num_splits=None,
+):
+    import torch_npu
+
+    if dropout_p != 0.0:
+        raise NotImplementedError("npu flash attention: dropout_p must be 0")
+    if alibi_slopes is not None or block_table is not None or seqused_k is not None:
+        raise NotImplementedError("npu flash attention: alibi_slopes/block_table/seqused_k unsupported")
+    varlen = cum_seq_q is not None
+    layout = "TND" if varlen else "BSND"
+    n_heads = query.shape[1] if varlen else query.shape[2]
+    head_dim = query.shape[-1]
+    if scale is None:
+        scale = head_dim**-0.5
+    sparse_mode, pre_tokens, next_tokens = _sparse_args(is_causal, window_size_left, window_size_right)
+    ends_q = _offsets(cum_seq_q) if varlen else None
+    ends_k = _offsets(cum_seq_k) if varlen else None
+    out, smax, ssum, *_ = torch_npu.npu_fusion_attention(
+        query,
+        key,
+        value,
+        n_heads,
+        layout,
+        atten_mask=_causal_mask(query.device) if sparse_mode in (3, 4) else None,
+        scale=scale,
+        pre_tockens=pre_tokens,
+        next_tockens=next_tokens,
+        actual_seq_qlen=ends_q,
+        actual_seq_kvlen=ends_k,
+        sparse_mode=sparse_mode,
+    )
+    lse = _lse_from_stats(smax, ssum, layout, n_heads, ends_q)
+    rng_state = torch.zeros((2,), dtype=torch.int64, device=query.device)
+    empty = torch.empty(0, dtype=query.dtype, device=query.device)
+    return out, lse, rng_state, empty, empty
+
+
+def _flash_attention_backward_npu(
+    grad_out,
+    query,
+    key,
+    value,
+    out,
+    logsumexp,
+    cum_seq_q,
+    cum_seq_k,
+    max_q,
+    max_k,
+    dropout_p,
+    is_causal,
+    rng_state,
+    unused,
+    *,
+    scale=None,
+    window_size_left=None,
+    window_size_right=None,
+):
+    import torch_npu
+
+    varlen = cum_seq_q is not None
+    layout = "TND" if varlen else "BSND"
+    n_heads = query.shape[1] if varlen else query.shape[2]
+    if scale is None:
+        scale = query.shape[-1] ** -0.5
+    sparse_mode, pre_tokens, next_tokens = _sparse_args(is_causal, window_size_left, window_size_right)
+    ends_q = _offsets(cum_seq_q) if varlen else None
+    ends_k = _offsets(cum_seq_k) if varlen else None
+    smax, ssum = _stats_from_lse(logsumexp, layout, tuple(query.shape), ends_q)
+    dq, dk, dv, *_ = torch_npu.npu_fusion_attention_grad(
+        query,
+        key,
+        value,
+        grad_out.contiguous(),
+        n_heads,
+        layout,
+        atten_mask=_causal_mask(query.device) if sparse_mode in (3, 4) else None,
+        softmax_max=smax,
+        softmax_sum=ssum,
+        attention_in=out,
+        scale_value=scale,
+        pre_tockens=pre_tokens,
+        next_tockens=next_tokens,
+        actual_seq_qlen=ends_q,
+        actual_seq_kvlen=ends_k,
+        sparse_mode=sparse_mode,
+    )
+    return dq, dk, dv
+
+
+def _register_npu_flash_attention():
+    if getattr(torch.ops.aten, "_npu_flash_attention_registered", False):
+        return
+    lib = torch.library.Library("aten", "IMPL")
+    lib.impl("_flash_attention_forward", _flash_attention_forward_npu, "PrivateUse1")
+    lib.impl("_flash_attention_backward", _flash_attention_backward_npu, "PrivateUse1")
+    torch.ops.aten._npu_flash_attention_registered = True
+    _register_npu_flash_attention._lib = lib  # keep the Library object alive
