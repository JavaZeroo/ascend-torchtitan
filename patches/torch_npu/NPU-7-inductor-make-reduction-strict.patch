From 1509349ff9e2f9e26c6bbd22d5aef3e5c71af672 Mon Sep 17 00:00:00 2001
From: JavaZeroo <2487163254@qq.com>
Date: Sun, 30 Aug 2026 01:43:33 +0800
Subject: [PATCH] fix: accept strict_reduction in the NPU make_reduction
 override (torch 2.15)

torch 2.15 changed torch._inductor.lowering.make_reduction to take a
keyword-only strict_reduction argument and passes it from the aten.sum
lowering (sum_ -> make_reduction("sum", ..., strict_reduction=...)); it also
hands reduction_type= to _make_reduction_inner and strict_reduction= to
Reduction.create. torch_npu replaces make_reduction with its own version
(dump_fx_graph support) whose signature predates this, so any compiled
graph containing a multi-dim sum fails at lowering time on torch 2.15:

  torch._inductor.exc.InductorError: LoweringException: TypeError:
  make_reduction() got an unexpected keyword argument 'strict_reduction'

(seen with torch.compile(flex_attention) on torch 2.15.0.dev20260812).

Accept strict_reduction in the override and forward reduction_type /
strict_reduction to _make_reduction_inner / Reduction.create whenever the
installed torch declares them (checked once via inspect.signature), so the
override keeps torch's call contract on every supported torch line.

Test: test/_inductor/test_sum_strict_reduction.py (signature + compiled
multi-dim sum vs eager).

Upstream-PR: https://gitcode.com/Ascend/pytorch/merge_requests/45528
Upstream-Issue: https://gitcode.com/Ascend/pytorch/issues/4440
---
 test/_inductor/test_sum_strict_reduction.py | 36 +++++++++++++++++++++
 torch_npu/_inductor/lowering.py             | 18 ++++++++++-
 2 files changed, 53 insertions(+), 1 deletion(-)
 create mode 100644 test/_inductor/test_sum_strict_reduction.py

diff --git a/test/_inductor/test_sum_strict_reduction.py b/test/_inductor/test_sum_strict_reduction.py
new file mode 100644
index 000000000..b267c9a36
--- /dev/null
+++ b/test/_inductor/test_sum_strict_reduction.py
@@ -0,0 +1,36 @@
+import inspect
+
+import torch
+from torch.testing._internal.common_utils import run_tests, parametrize, instantiate_parametrized_tests
+from testutils import TestUtils
+
+
+class TestSumStrictReduction(TestUtils):
+    """torch >= 2.15 lowers aten.sum through make_reduction(..., strict_reduction=...); the NPU
+    override of make_reduction must accept the keyword (it used to raise
+    'make_reduction() got an unexpected keyword argument strict_reduction')."""
+
+    def test_make_reduction_signature(self):
+        from torch_npu._inductor.lowering import make_reduction
+
+        self.assertIn("strict_reduction", inspect.signature(make_reduction).parameters)
+        self.assertTrue(callable(make_reduction("sum", strict_reduction=True)))
+        self.assertTrue(callable(make_reduction("max")))
+
+    def foo(self, a, dims):
+        return a.sum(dims)
+
+    @parametrize('shape', [(2, 4, 32, 64)])
+    @parametrize('dims', [(-2, -1), (0,), (1, 3)])
+    def test_sum_multi_dim_compile(self, shape, dims):
+        a = torch.randn(shape, dtype=torch.float32, device="npu")
+        r1 = self.foo(a, dims)
+        func = torch.compile(self.foo, backend="inductor", dynamic=False)
+        r = func(a, dims)
+        self.assertEqual(r, r1, atol=1e-3, rtol=1e-3)
+
+
+instantiate_parametrized_tests(TestSumStrictReduction)
+
+if __name__ == "__main__":
+    run_tests()
diff --git a/torch_npu/_inductor/lowering.py b/torch_npu/_inductor/lowering.py
index 5f5bb602f..4665cec68 100644
--- a/torch_npu/_inductor/lowering.py
+++ b/torch_npu/_inductor/lowering.py
@@ -14,6 +14,8 @@
 # See the License for the specific language governing permissions and
 # limitations under the License.
 
+import inspect
+
 import sympy
 
 import torch._ops
@@ -141,15 +143,29 @@ if npu_config.dump_fx_graph:
     scheduler._prune_redundant_deps = _npu_prune_redundant_deps
     Scheduler._get_unmet_dep_nodes = _npu_get_unmet_dep_nodes
 
-def make_reduction(reduction_type: ReductionType, override_return_dtype=None):
+# torch's make_reduction / _make_reduction_inner / Reduction.create grew keyword-only
+# parameters across releases (reduction_type= on _make_reduction_inner, strict_reduction=
+# on make_reduction and Reduction.create in 2.15). Mirror them when the installed torch has
+# them so the override keeps torch's call contract on every supported line.
+_REDUCTION_INNER_TAKES_TYPE = "reduction_type" in inspect.signature(_make_reduction_inner).parameters
+_REDUCTION_CREATE_TAKES_STRICT = "strict_reduction" in inspect.signature(Reduction.create).parameters
+
+
+def make_reduction(reduction_type: ReductionType, override_return_dtype=None, *, strict_reduction=False):
     def inner(x, axis=None, keepdims=False, *, dtype=None):
+        inner_kwargs = {}
+        if _REDUCTION_INNER_TAKES_TYPE:
+            inner_kwargs["reduction_type"] = reduction_type
         kwargs = _make_reduction_inner(
             x,
             axis=axis,
             keepdims=keepdims,
             dtype=dtype,
             override_return_dtype=override_return_dtype,
+            **inner_kwargs,
         )
+        if _REDUCTION_CREATE_TAKES_STRICT:
+            kwargs["strict_reduction"] = strict_reduction
         if npu_config.dump_fx_graph:
             node_name = f'reduction_{next(node_id)}'
             input_graphs = fetch_graphs([x, axis if axis is not None else list(range(len(x.get_size())))])
