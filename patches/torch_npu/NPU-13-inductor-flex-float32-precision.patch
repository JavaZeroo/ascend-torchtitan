From d2cd8735040cdb07ed47d93eabf44698802639a0 Mon Sep 17 00:00:00 2001
From: JavaZeroo <2487163254@qq.com>
Date: Fri, 4 Sep 2026 14:03:01 +0800
Subject: [PATCH] fix(inductor): follow torch's FLOAT32_PRECISION API in the
 flex lowering

Symptom: on a torch nightly newer than 2.15.0.dev20260902, importing anything
that touches torch_npu._inductor dies:

  ImportError: cannot import name 'get_float32_precision' from
  'torch._inductor.kernel.flex.flex_attention'
  During handling of the above exception, another exception occurred:
  ModuleNotFoundError: No module named 'torch._inductor.kernel.flex_attention'

Root cause: torch replaced the getter get_float32_precision() with the setter
set_float32_precision(kernel_options, dtype), which additionally handles the
bfx9 fp32 mode the getter could not express. flex_attention.py imported the old
name inside the bulk import from the post-split flex/ package, so losing that
one symbol failed the whole block. The except ImportError branch then reached
for torch._inductor.kernel.flex_attention, a pre-split path that no longer
exists on any torch line this repo builds against (2.13 and 2.15 both ship
torch/_inductor/kernel/flex/), so the fallback could not fire and only replaced
a precise error with a misleading one.

Fix: import get_float32_precision separately from the bulk blocks and bind
_set_float32_precision to whichever API the installed torch provides, newest
first, falling back to a wrapper around the getter. The three lowering call
sites now pass the query dtype, matching upstream's own call sites.

Test: python test/_inductor/test_flex_float32_precision.py

Upstream-PR: https://gitcode.com/Ascend/pytorch/merge_requests/45789
Upstream-Issue: https://gitcode.com/Ascend/pytorch/issues/4606
---
 test/_inductor/test_flex_float32_precision.py | 50 +++++++++++++++++++
 torch_npu/_inductor/kernel/flex_attention.py  | 27 ++++++++--
 2 files changed, 72 insertions(+), 5 deletions(-)
 create mode 100644 test/_inductor/test_flex_float32_precision.py

diff --git a/test/_inductor/test_flex_float32_precision.py b/test/_inductor/test_flex_float32_precision.py
new file mode 100644
index 000000000..ddf98e2de
--- /dev/null
+++ b/test/_inductor/test_flex_float32_precision.py
@@ -0,0 +1,50 @@
+import torch
+import torch_npu  # noqa: F401
+from torch_npu._inductor.kernel import flex_attention as npu_flex
+from torch_npu.testing.testcase import TestCase, run_tests
+
+
+class TestFlexFloat32Precision(TestCase):
+    """The NPU FlexAttention lowering must follow torch's FLOAT32_PRECISION API.
+
+    torch used to expose ``get_float32_precision()`` in
+    ``torch._inductor.kernel.flex.flex_attention`` and replaced it with
+    ``set_float32_precision(kernel_options, dtype)``, which also covers the bfx9
+    fp32 mode. This module imported the old name unconditionally, so on a torch
+    that no longer defines it the whole import chain died with
+
+      ImportError: cannot import name 'get_float32_precision' from
+      'torch._inductor.kernel.flex.flex_attention'
+
+    and the ``except ImportError`` fallback then reported the far more confusing
+
+      ModuleNotFoundError: No module named 'torch._inductor.kernel.flex_attention'
+
+    because that pre-split module is gone from every torch release line this
+    builds against. Importing ``torch_npu._inductor`` therefore failed outright.
+    """
+
+    def test_adapter_is_bound(self):
+        self.assertTrue(callable(npu_flex._set_float32_precision))
+
+    def test_prefers_upstream_setter_when_present(self):
+        upstream = torch._inductor.kernel.flex.flex_attention
+        if not hasattr(upstream, "set_float32_precision"):
+            self.skipTest("this torch still exposes the getter only")
+        self.assertIs(npu_flex._set_float32_precision, upstream.set_float32_precision)
+
+    def test_populates_kernel_options(self):
+        for dtype in (torch.bfloat16, torch.float16, torch.float32):
+            kernel_options = {}
+            npu_flex._set_float32_precision(kernel_options, dtype)
+            precision = kernel_options.get("FLOAT32_PRECISION")
+            self.assertTrue(precision in ("'ieee'", "'tf32'"), f"{dtype}: {precision}")
+
+    def test_caller_supplied_precision_wins(self):
+        kernel_options = {"FLOAT32_PRECISION": "'ieee'"}
+        npu_flex._set_float32_precision(kernel_options, torch.bfloat16)
+        self.assertEqual(kernel_options["FLOAT32_PRECISION"], "'ieee'")
+
+
+if __name__ == "__main__":
+    run_tests()
diff --git a/torch_npu/_inductor/kernel/flex_attention.py b/torch_npu/_inductor/kernel/flex_attention.py
index d24f8f6f1..1070d7192 100644
--- a/torch_npu/_inductor/kernel/flex_attention.py
+++ b/torch_npu/_inductor/kernel/flex_attention.py
@@ -80,7 +80,6 @@ try:
     )
     from torch._inductor.kernel.flex.flex_attention import (
         get_bwd_subgraph_outputs,
-        get_float32_precision,
         process_joint_outputs,
         validate_joint_graph,
     )
@@ -91,7 +90,6 @@ except ImportError:
         create_num_blocks_fake_generator,
         create_placeholder,
         get_bwd_subgraph_outputs,
-        get_float32_precision,
         get_fwd_subgraph_outputs,
         infer_dense_strides,
         maybe_realize,
@@ -118,6 +116,25 @@ except ImportError:
 
             return tree_map_only(IRNode, freeze, tree)
 
+# FLOAT32_PRECISION: torch replaced the ``get_float32_precision()`` getter with
+# ``set_float32_precision(kernel_options, dtype)`` (the setter also handles the
+# bfx9 fp32 mode, which the getter had no way to express). Bind whichever the
+# installed torch provides, newest first, so a version bump does not break the
+# import of this module.
+try:
+    from torch._inductor.kernel.flex.flex_attention import (
+        set_float32_precision as _set_float32_precision,
+    )
+except ImportError:
+    try:
+        from torch._inductor.kernel.flex.flex_attention import get_float32_precision
+    except ImportError:
+        from torch._inductor.kernel.flex_attention import get_float32_precision
+
+    def _set_float32_precision(kernel_options, dtype):
+        """Pre-setter torch: the getter returns the already-quoted precision."""
+        kernel_options.setdefault("FLOAT32_PRECISION", get_float32_precision())
+
 # PyTorch flex_attention exposes/saves LSE in log2 space, matching the
 # upstream kernels that use exp2/log2. NPU templates below compute LSE with
 # natural exp/log, so the lowering boundary converts between the two bases.
@@ -1768,7 +1785,7 @@ def _lower_flex_attention_backward_mask_in(
     )
 
     kernel_options = kernel_options.copy()
-    kernel_options.setdefault("FLOAT32_PRECISION", get_float32_precision())
+    _set_float32_precision(kernel_options, query.get_dtype())
     kernel_options.setdefault("PRESCALE_QK", False)
     kernel_options.setdefault("ROWS_GUARANTEED_SAFE", False)
     kernel_options.setdefault("BLOCKS_ARE_CONTIGUOUS", False)
@@ -2044,7 +2061,7 @@ def _register_npu_inductor_flex_attention():
             else v
             for k, v in kernel_options.items()
         }
-        kernel_options.setdefault("FLOAT32_PRECISION", get_float32_precision())
+        _set_float32_precision(kernel_options, query.get_dtype())
         score_mod_is_identity = _is_score_mod_identity_graph(subgraph)
         has_score_mod = has_explicit_score_mod and not score_mod_is_identity
         enable_gqa = V.graph.sizevars.evaluate_expr(
@@ -2727,7 +2744,7 @@ def _register_npu_inductor_flex_attention():
         }
         kernel_options.setdefault("ROWS_GUARANTEED_SAFE", False)
         kernel_options.setdefault("BLOCKS_ARE_CONTIGUOUS", False)
-        kernel_options.setdefault("FLOAT32_PRECISION", get_float32_precision())
+        _set_float32_precision(kernel_options, query.get_dtype())
         kernel_options.setdefault(
             "IS_DIVISIBLE",
             _sequence_lengths_are_statically_divisible(seq_len_q, seq_len_kv),
